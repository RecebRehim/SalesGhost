# Serverless REST API (Vercel → /api/salesghost) — set these in Vercel Project → Settings → Environment Variables
# Do NOT expose SALESGHOST_API_KEY in the browser.

SALESGHOST_API_KEY=generate-a-long-random-string-for-n8n

# Same Supabase values as the app (either pair works — the API checks both names):
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional aliases if you only added VITE_* for the frontend:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
