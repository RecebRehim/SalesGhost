# Serverless REST API (Vercel) — set in Project → Settings → Environment Variables
# Do NOT expose SALESGHOST_API_KEY in the browser.

SALESGHOST_API_KEY=generate-a-long-random-string-for-n8n

# Same Supabase values as the app (either pair works — the API checks both names):
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional aliases if you only added VITE_* for the frontend:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- Endpoints (same X-API-Key header for all) ---
# GET  https://YOUR_DOMAIN.vercel.app/api/salesghost
# POST https://YOUR_DOMAIN.vercel.app/api/chat-message
#      JSON body: { "message": "Hello customer!", "title": "Offer" }
